PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/bigbazaar
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Email SMTP (optional, falls back to dev console logger)
EMAIL=
PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Integrations (optional, defaults to mock)
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
