# MyBigBazaar Admin Panel Environment Configuration
# Set VITE_API_BASE_URL to the backend developer's live backend URL:
# Example: VITE_API_BASE_URL=https://api.mybigbazaar.com
# For local development with local backend: VITE_API_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=https://api.mybigbazaar.com
VITE_STOREFRONT_URL=https://mybigbazaar.com
